# Approved template for overdue reminders (business-initiated messages).
# Body variables: {{1}} customer name, {{2}} invoice number, {{3}} amount due, {{4}} days overdue, {{5}} payment link
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=ar

# PDF engine (Gotenberg). docker-compose starts it at http://gotenberg:3000
GOTENBERG_URL=
GOTENBERG_TIMEOUT=30

# AI insights (OpenAI). Without a key, rule-based insights are shown.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30

# Online payments – Lahza (Palestine). Webhook URL: {APP_URL}/api/webhooks/lahza
LAHZA_SECRET_KEY=
LAHZA_PUBLIC_KEY=
LAHZA_BASE_URL=https://api.lahza.io
LAHZA_CURRENCY=ILS
